{
  "name": "secretary-hq-agent",
  "version": "0.1.0",
  "private": true,
  "description": "LiveKit voice agent worker for SecretaryHQ — replaces Vapi as the orchestrator between Telnyx (SIP) and Deepgram/OpenAI (TTS fully OpenAI since 2026-06-25).",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts dev",
    "dev:local": "NODE_EXTRA_CA_CERTS=../certs/localhost-cert.pem AGENT_NAME=secretary-hq-agent-dev NUM_IDLE_PROCESSES=1 DNS_FORCE_IPV4=true BACKEND_URL=${BACKEND_URL:-https://localhost:4001} tsx watch src/index.ts dev",
    "build": "tsc -p .",
    "start": "node dist/index.js start",
    "download-files": "node dist/index.js download-files",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,json,md}\" \"*.{json,md}\" --config ../.prettierrc.json --ignore-path ../.prettierignore",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,json,md}\" \"*.{json,md}\" --config ../.prettierrc.json --ignore-path ../.prettierignore",
    "verify:tts": "node scripts/verify-tts.mjs"
  },
  "dependencies": {
    "@livekit/agents": "^1.6.4",
    "@livekit/agents-plugin-deepgram": "^1.6.4",
    "@livekit/agents-plugin-openai": "^1.6.4",
    "@livekit/agents-plugin-silero": "^1.6.4",
    "@logtail/pino": "^0.5.8",
    "@sentry/node": "^10.70.0",
    "dotenv": "^17.4.2",
    "livekit-server-sdk": "^2.17.0",
    "pino": "^10.3.1",
    "@livekit/rtc-node": "^0.13.33",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript-eslint-ts6": "npm:typescript@^6.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
