# dependencies
# Unanchored so it matches at ANY depth, not just the three known workspaces.
# vitest writes a cache to src/node_modules/.vite, which the previous anchored
# rules missed — it showed up as untracked noise in every `git status`.
node_modules/

# Per-branch scratch worklist: scripts/create-feature-branch.sh copies
# docs/BRANCH_CHECKLIST.md here on every new branch. Commit 453e538 untracked the
# root copy but left the script's `cp`, so it surfaced as untracked noise forever.
# Anchored — docs/BRANCH_CHECKLIST.md stays tracked as the source of truth.
/BRANCH_CHECKLIST.md

# build artifacts
/dist
/dashboard/.next
/dashboard/out
/dashboard/build
/agent/dist

# supabase CLI version cache (auto-managed by `supabase` binary)
/supabase/.temp/

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
/coverage
/coverage_data
# Match coverage output from any package (backend, agent, dashboard).
**/coverage/

# environment variables
.env
.env.local
.env.*.local
dashboard/.env.local

# sensitive files
pw.txt
output.txt

# misc
.DS_Store
.idea
.vscode
*.swp
*.bak
.Clairvoyance/
.gemini/

# Deno
.deno
.deno_plugins
dashboard/dist/

# Production secrets
.env.production
.env.production.save

# Journal-loop generator output. Retired 2026-05-07 (commit 6b43c8e).
# The generator still runs on a separate schedule and recreates these
# files; gitignored so output stays untracked rather than reappearing
# in working-tree status every session.
improvement-ideas.md
.remember/

# Claude Code harness state (per-machine, not source-controlled) — except the
# shared `remember` skill, its memory, and the Stop hook that fills it — cloud sessions need these.
.claude/*
!.claude/skills/
!.claude/memory/
!.claude/hooks/
!.claude/settings.json

# continuously-improve loop state (per-machine, session-scoped)
.improve/

# Playwright test output (build artifact)
test-results/

# Windows "downloaded file" mark-of-the-web cruft
*:Zone.Identifier

# Local Netlify folder
.netlify

.trash/

# Local Obsidian vault config (editor state — not source)
.obsidian/
scripts/script-backups/

# External audit output (Grok watcher) — local artifacts, never committed
GROK_FINDINGS-*.md
.grok-audit/
