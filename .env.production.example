# =============================================================================
# SecretaryHQ - Production Environment Variables
# =============================================================================
# Copy this file to .env.production and set these on the Railway services.
# Deploys happen by merging to `main` — see README "Deployment".

# === Database (Supabase) ===
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_ID.supabase.co:5432/postgres

# === AI & Voice ===
# DEEPGRAM for STT (Nova-3) + TTS (Aura). OPENAI for LLM/summaries/embeddings only.
DEEPGRAM_API_KEY=your-deepgram-key
OPENAI_API_KEY=sk-proj-...

# === Telephony (Telnyx → LiveKit) ===
# Telnyx API key authorizes phone-number purchase, SMS OTP, and number release.
TELNYX_API_KEY=KEY01...
# Telnyx SIP Connection ID — purchased numbers routed to LiveKit.
TELNYX_SIP_CONNECTION_ID=
TELNYX_PUBLIC_KEY=

# === LiveKit (voice agent) ===
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Shared secret the LiveKit agent uses to call /agent-tools/* on the backend.
AGENT_SECRET=

# === Auth ===
JWT_SECRET=generate-a-strong-random-string-at-least-32-chars
JWT_EXPIRY=8h

# === Billing (Stripe) ===
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SOLO_PRICE_ID=price_...
STRIPE_GROWTH_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...
# Optional plan call caps (answered calls / UTC month). Empty = code defaults
# (Solo 350, Growth 1000, Professional unlimited). 0/unlimited = unlimited.
# PLAN_CAP_SOLO=350
# PLAN_CAP_GROWTH=1000
# PLAN_CAP_PROFESSIONAL=unlimited
# USAGE_WARN_RATIO=0.8
# USAGE_SOFT_CAP_ENFORCE=true

# === Deployment URLs ===
NEXT_PUBLIC_API_BASE_URL=https://your-backend.railway.app
# Base URL the agent embeds in self-service links it texts to callers.
DASHBOARD_URL=https://www.secretaryhq.com
NODE_ENV=production
PORT=4001

# === Initial Admin ===
ADMIN_EMAIL=admin@secretaryhq.com
ADMIN_PASSWORD=change-this-to-something-secure
