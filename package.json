{
  "name": "secretary-hq-backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/src/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev:backend": "ts-node-dev --respawn --transpile-only src/index.ts",
    "dev:dashboard": "cd dashboard && npm run dev",
    "test": "vitest run tests/ scripts/ --fileParallelism=false",
    "test:ci": "DATABASE_URL=postgres://postgres:postgres@localhost:5433/test_db vitest run src/ scripts/ --fileParallelism=false",
    "test-db:start": "bash scripts/start-test-db.sh",
    "verify:claude-md": "npx tsx scripts/verify-claude-md.ts",
    "verify:schema": "npx tsx scripts/verify-schema-alignment.ts",
    "bootstrap": "bash scripts/bootstrap.sh",
    "db:migrate": "bash scripts/setup-db.sh",
    "db:seed": "bash scripts/seed-db.sh",
    "db:rebuild": "bash scripts/rebuild-db.sh",
    "db:baseline": "bash scripts/generate-baseline.sh",
    "trees:seed": "npx tsx scripts/seed-question-tree-templates.ts",
    "trees:rollout": "npx tsx scripts/deploy-question-trees.ts",
    "trees:verify": "npx tsx scripts/verify-tenant-question-trees.ts",
    "local:business": "npx tsx scripts/seed-local-business.ts",
    "trees:local": "npx tsx scripts/seed-question-tree-templates.ts --db ${DATABASE_URL:-postgres://postgres:postgres@localhost:5433/postgres} --force && npx tsx scripts/deploy-question-trees.ts --db ${DATABASE_URL:-postgres://postgres:postgres@localhost:5433/postgres} --apply --refresh-uncustomized",
    "start": "bash scripts/start-all.sh",
    "restart": "bash scripts/restart-all.sh",
    "build": "tsc -p .",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\" \"scripts/**/*.{ts,tsx,js,jsx,json}\" \"shared/**/*.{ts,tsx,js,jsx,json}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,md}\" \"scripts/**/*.{ts,tsx,js,jsx,json}\" \"shared/**/*.{ts,tsx,js,jsx,json}\" \"*.{json,md}\"",
    "checks": "npm run format:check && npm run lint && npx tsc --noEmit && npm run checks:agent && cd dashboard && npx tsc --noEmit",
    "checks:agent": "cd agent && npm run format:check && npm run lint && npm run typecheck",
    "pre-pr": "npm run checks && npm test && echo 'Consider running relevant E2E: cd dashboard && npx playwright test --grep \"<pattern>\"'",
    "create-branch": "bash scripts/create-feature-branch.sh",
    "setup-hooks": "bash scripts/setup-hooks.sh",
    "remove-hooks": "bash scripts/remove-hooks.sh",
    "prepare": "husky",
    "prepare-commit": "bash scripts/prepare-commit.sh",
    "generate-kit": "bash scripts/generate-portable-kit.sh",
    "status": "bash scripts/simulate.sh status --deep",
    "ci:status": "bash scripts/simulate.sh ci",
    "ci:watch": "bash scripts/simulate.sh ci --watch",
    "starter-services:generate": "npx tsx scripts/generate-starter-services-sql.ts",
    "verify:starter-services": "npx tsx scripts/generate-starter-services-sql.ts --check",
    "scan:secrets": "npx tsx scripts/scan-secrets.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@logtail/pino": "^0.5.8",
    "@sentry/node": "^10.70.0",
    "@supabase/supabase-js": "^2.112.3",
    "@types/jsonwebtoken": "^9.0.10",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.0",
    "googleapis": "^174.0.1",
    "jsonwebtoken": "^9.0.3",
    "livekit-server-sdk": "^2.17.0",
    "next": "^16.3.1",
    "nodemailer": "^9.0.5",
    "pdf-parse": "^2.4.5",
    "stripe": "^22.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.21.0",
    "@types/testing-library__react": "^10.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.5",
    "eslint": "^10.8.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "supabase": "^2.114.0",
    "ts-node-dev": "^2.0.0",
    "typescript-eslint-ts6": "npm:typescript@^6.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
